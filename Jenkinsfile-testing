pipeline {    

    agent any    
    
    environment {
        MSR_FQDN_PORT='<registry dynamic DNS>:4443'
    }

    stages {
        stage('Promote') {
            environment {
                MSR_ACCESS_KEY = credentials('jenkins-msr-access-token')
            }
            steps {
                // gate on the Trivy scan MSR ran on push (loose limit for the demo; use 0 in real life)
                sh 'CRITICAL=$(curl -sf -u jenkins:${MSR_ACCESS_KEY} \
                        "https://${MSR_FQDN_PORT}/api/v2.0/projects/engineering/repositories/api-build/artifacts/${TAG}?with_scan_overview=true" \
                        | jq "[.scan_overview[].summary.summary.Critical // 0] | add"); \
                    echo "Critical vulnerabilities in ${TAG}: ${CRITICAL}"; \
                    test "${CRITICAL}" -lt 100'
                // promote: copy the scanned artifact into engineering/api-test
                sh 'curl -sf -u jenkins:${MSR_ACCESS_KEY} -X POST \
                        "https://${MSR_FQDN_PORT}/api/v2.0/projects/engineering/repositories/api-test/artifacts?from=engineering/api-build:${TAG}"'
            }
        }
        stage('Unit') {
            environment {
                MSR_ACCESS_KEY = credentials('jenkins-msr-access-token')
            }
            steps {
                sh 'docker --context=testserver login -u jenkins -p ${MSR_ACCESS_KEY} ${MSR_FQDN_PORT}'
                sh 'docker --context=testserver image pull ${MSR_FQDN_PORT}/engineering/api-test:${TAG}'
                sh 'kubectl run $(echo $TAG | tr . -) \
                     -n testing \
                     --restart=Never --attach=True \
                     --overrides=\'{"apiVersion": "v1", "spec": {"nodeSelector": { "kubernetes.io/hostname": "testing" }}}\' \
                     --image=${MSR_FQDN_PORT}/engineering/api-test:${TAG}'
            }
        }
    }

    post {
        always{
            sh 'rm -rf ${WORKSPACE}/*'
        }
    }
}
